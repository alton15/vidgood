<UserControl x:Class="VideoPlayer.PlayerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black">
    <Border x:Name="ActiveBorder" BorderThickness="2" BorderBrush="Transparent">
        <vlc:VideoView x:Name="VideoView" Background="Black">
            <!-- Everything below is rendered by LibVLCSharp in a transparent window on top of the video. -->
            <!-- Background is set in code (UpdateMediaState). -->
            <Grid x:Name="OverlayRoot" Background="Black" AllowDrop="True"
                  TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
                  Loaded="OverlayRoot_Loaded"
                  PreviewMouseDown="OverlayRoot_PreviewMouseDown"
                  MouseLeftButtonDown="OverlayRoot_MouseLeftButtonDown"
                  MouseMove="OverlayRoot_MouseMove"
                  MouseWheel="OverlayRoot_MouseWheel"
                  DragOver="OverlayRoot_DragOver"
                  DragLeave="OverlayRoot_DragLeave"
                  Drop="OverlayRoot_Drop">

                <!-- Empty state -->
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="52"
                               Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="동영상 파일이나 폴더를 여기로 끌어다 놓으세요" Foreground="#B0FFFFFF"
                               FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="파일 열기" Style="{StaticResource AccentButton}" Click="OpenFile_Click"/>
                        <Button Content="폴더 열기" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- On-screen feedback (seek, speed, volume) -->
                <Border x:Name="Osd" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Background="#B0000000" CornerRadius="8" Padding="18,10" Opacity="0">
                    <TextBlock x:Name="OsdText" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </Border>

                <!-- Top bar -->
                <Grid x:Name="TopBar" VerticalAlignment="Top" Height="52">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A0000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <DockPanel Margin="6,6,8,0" VerticalAlignment="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="AudioCheck" Style="{StaticResource OverlayCheckBox}" Content="소리" IsChecked="True"
                                      ToolTip="이 화면의 소리 켜기/끄기" Visibility="Collapsed"
                                      Checked="AudioCheck_Changed" Unchecked="AudioCheck_Changed"/>
                            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="14"
                                    ToolTip="화면 배치" Click="MoreButton_Click"/>
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13"
                                    ToolTip="이 화면 닫기 (Ctrl+W)" Click="CloseButton_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Drag handle: drop on another pane to dock/swap, or outside the windows to pop out. -->
                        <Border x:Name="DragHandle" HorizontalAlignment="Left" Height="34" Padding="8,0" CornerRadius="6"
                                Cursor="SizeAll" ToolTip="끌어서 다른 화면 옆이나 가운데(위치 교환)에 놓기 · 창 밖에 놓으면 새 창"
                                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                MouseMove="DragHandle_MouseMove"
                                MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#01000000"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="White" FontSize="14" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Playlist -->
                <Border x:Name="PlaylistPanel" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="300"
                        Margin="0,52,10,118" Background="#EE1E1E1E" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="14,8,6,4">
                            <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="12" Height="30"
                                    Foreground="{StaticResource SubtleTextBrush}" ToolTip="정렬 기준 바꾸기" Click="SortButton_Click"/>
                            <TextBlock x:Name="PlaylistHeader" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0" Margin="4,0,4,6"
                                 Focusable="False" ItemContainerStyle="{StaticResource PlaylistItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="PlaylistBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Bottom control bar -->
                <Border x:Name="ControlBar" VerticalAlignment="Bottom" Padding="14,28,14,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#D0000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="White" FontSize="12"
                                       VerticalAlignment="Center" MinWidth="44"/>
                            <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="8,0"
                                    Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged"/>
                            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Foreground="White" FontSize="12"
                                       VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                                        ToolTip="음소거 (M)" Click="MuteButton_Click"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource FlatSlider}" Width="90" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                        ToolTip="이전 영상 (PageUp)" Click="PrevButton_Click"/>
                                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="BackButton_Click" Margin="2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BackSecondsText" FontFamily="Segoe UI" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Click="PlayButton_Click" Margin="4,0"
                                        ToolTip="재생/일시정지 (Space)">
                                    <TextBlock x:Name="PlayIcon" Text="&#xE768;"/>
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="ForwardButton_Click" Margin="2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ForwardSecondsText" FontFamily="Segoe UI" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE7A6;" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                        ToolTip="다음 영상 (PageDown)" Click="NextButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True">
                                <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="13"
                                        MinWidth="48" ToolTip="재생 속도 ([ / ])" Click="SpeedButton_Click"/>
                                <Button x:Name="TracksButton" Style="{StaticResource IconButton}" Content="&#xE7F0;"
                                        ToolTip="자막 및 오디오" Click="TracksButton_Click"/>
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;"
                                        Click="RepeatButton_Click"/>
                                <Button x:Name="PlaylistButton" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                                        ToolTip="재생 목록 (Ctrl+L)" Click="PlaylistButton_Click"/>
                                <Button x:Name="RotateButton" Style="{StaticResource IconButton}" Content="&#xE7AD;"
                                        ToolTip="90° 회전 (Ctrl+R)" Click="RotateButton_Click"/>
                                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                        ToolTip="전체 화면 (F11)" Click="FullscreenButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Where a dragged pane will land -->
                <Border x:Name="DropIndicator" Visibility="Collapsed" IsHitTestVisible="False" Margin="6"
                        Background="#504CC2FF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6">
                    <TextBlock x:Name="DropIndicatorText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Border>
</UserControl>
