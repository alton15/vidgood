<Window x:Class="VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoPlayer"
        Title="VidGood" Icon="/Assets/app.ico" Width="1280" Height="760" MinWidth="560" MinHeight="380"
        Background="#141414" WindowStartupLocation="CenterScreen" AllowDrop="True"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar" Background="#202020" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ToggleButton x:Name="TopmostButton" Style="{StaticResource ToolbarToggle}" ToolTip="항상 위에 표시"
                                  Checked="TopmostButton_Changed" Unchecked="TopmostButton_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="항상 위" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="ShortcutsButton" Style="{StaticResource ToolbarButton}" Click="ShortcutsButton_Click">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" Click="SettingsButton_Click">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenFileButton" Style="{StaticResource ToolbarButton}" Click="OpenFileButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="파일 열기" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderButton" Style="{StaticResource ToolbarButton}" Click="OpenFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="폴더 열기" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="8,6" Background="#3A3A3A"/>
                    <Button x:Name="AddPaneButton" Style="{StaticResource ToolbarButton}" Click="AddPaneButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="화면 추가" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewWindowButton" Style="{StaticResource ToolbarButton}" Click="NewWindowButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE78B;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="새 창" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SoundButton" Style="{StaticResource ToolbarButton}" ToolTip="여러 화면의 소리 설정" Click="SoundButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SoundButtonText" Text="소리: 모든 화면" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PaneHint" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <local:PaneHost x:Name="PanesHost" Grid.Row="1"/>
    </Grid>
</Window>
