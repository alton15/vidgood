<Window x:Class="VideoPlayer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VidGood 준비 중" Icon="/Assets/app.ico" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/app.ico" Width="28" Height="28"/>
            <TextBlock Text="VidGood 준비 중…" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="처음 실행할 때 한 번만 재생 엔진을 설치합니다." Foreground="{StaticResource SubtleTextBrush}"
                   FontSize="12" Margin="0,12,0,14"/>
        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="1" BorderThickness="0"
                     Background="#3A3A3A" Foreground="{StaticResource AccentBrush}"/>
    </StackPanel>
</Window>
