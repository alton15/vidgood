<Window x:Class="VideoPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="560" Height="660" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="24,20,24,20">
        <TextBlock DockPanel.Dock="Top" Text="설정" FontSize="22" FontWeight="SemiBold"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,14">
            <RadioButton x:Name="GeneralTab" Content="일반" GroupName="Tabs" Style="{StaticResource SegmentButton}"
                         IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="ShortcutsTab" Content="단축키" GroupName="Tabs" Style="{StaticResource SegmentButton}"
                         Checked="Tab_Checked"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="저장" Style="{StaticResource AccentButton}" MinWidth="88" Click="Save_Click"/>
                <Button Content="취소" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="8,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>

        <Grid>
            <!-- General -->
            <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="건너뛰기 간격" FontWeight="SemiBold"/>
                            <TextBlock Text="뒤로/앞으로 건너뛰기 키와 버튼으로 이동하는 시간" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="12" Margin="0,2,0,10"/>
                            <WrapPanel x:Name="SeekOptionsPanel"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox x:Name="AutoPlayNextBox" Style="{StaticResource SwitchStyle}" Content="영상이 끝나면 다음 영상 자동 재생"/>
                            <CheckBox x:Name="FolderPlaylistBox" Style="{StaticResource SwitchStyle}" Content="파일 하나를 열면 같은 폴더의 영상을 재생 목록에 추가"/>
                            <CheckBox x:Name="FollowExplorerBox" Style="{StaticResource SwitchStyle}">
                                <StackPanel>
                                    <TextBlock Text="재생 목록을 탐색기 정렬 순서대로"/>
                                    <TextBlock Text="영상을 연 탐색기 창의 정렬을 따릅니다. 창이 없으면 재생 목록에서 고른 순서(기본: 수정한 날짜)"
                                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ResumeBox" Style="{StaticResource SwitchStyle}" Content="보던 위치부터 이어서 재생"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="16,8">
                        <CheckBox x:Name="FastSeekBox" Style="{StaticResource SwitchStyle}">
                            <StackPanel>
                                <TextBlock Text="빠른 탐색"/>
                                <TextBlock Text="가까운 키프레임으로 바로 이동해 끊김이 없지만 위치가 조금 덜 정확합니다. 탐색할 때 영상이 오래 멈추는 파일에 켜 보세요. (새로 여는 영상부터 적용)"
                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Shortcuts -->
            <DockPanel x:Name="ShortcutsPanel" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="모두 기본값으로" Style="{StaticResource SecondaryButton}"
                            Padding="12,5" Click="ResetAll_Click"/>
                    <TextBlock Text="키 버튼을 누른 뒤 원하는 키 조합을 입력하세요. (Esc: 취소)"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ShortcutList"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
